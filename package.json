{
  "name": "wrong-answer-notebook",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:desktop": "tauri dev",
    "build": "tsc -b && vite build",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest",
    "check": "npm run version:check && npm run lint && npm run check:debug && npm run check:mcp-contract && npm run check:tauri-contract && npm run test:startup && npm run test:release-contract && npm run test && npm run build",
    "check:mcp-contract": "node scripts/check-mcp-bridge-contract.mjs",
    "check:tauri-contract": "node --test scripts/tauri-command-contract.node.mjs && node scripts/check-tauri-command-contract.mjs",
    "check:debug": "node scripts/check-no-debug-markers.mjs",
    "version:set": "node scripts/set-version.mjs",
    "version:check": "node scripts/check-version-consistency.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:shared": "playwright test --config playwright.shared.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:startup": "node --test scripts/dependency-sync.node.mjs scripts/runtime-script-contract.node.mjs scripts/preview-runtime-contract.node.mjs",
    "test:release-contract": "node --test scripts/release-contract.node.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.4.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "@tauri-apps/plugin-process": "^2.3.0",
    "@tauri-apps/plugin-updater": "2.10.1",
    "jszip": "^3.10.1",
    "katex": "^0.17.0",
    "lucide-react": "^1.31.0",
    "pretendard": "^1.3.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.59.4",
    "vite": "^6.3.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  }
}
