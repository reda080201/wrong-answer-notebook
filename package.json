{
  "name": "wrong-answer-notebook",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest",
    "check": "npm run lint && npm run check:debug && npm run check:mcp-contract && npm run check:tauri-contract && npm run test && npm run build",
    "check:mcp-contract": "node scripts/check-mcp-bridge-contract.mjs",
    "check:tauri-contract": "node --test scripts/tauri-command-contract.node.mjs && node scripts/check-tauri-command-contract.mjs",
    "check:debug": "node scripts/check-no-debug-markers.mjs",
    "version:set": "node scripts/set-version.mjs",
    "version:check": "node scripts/check-version-consistency.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.4.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "@tauri-apps/plugin-process": "^2.3.0",
    "@tauri-apps/plugin-updater": "2.10.1",
    "jszip": "^3.10.1",
    "katex": "^0.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.59.4",
    "vite": "^6.3.0",
    "vitest": "^4.1.7"
  }
}
